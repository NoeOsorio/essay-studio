{
  "name": "essay-studio-sidecar",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "dist/sage.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "eval:validate": "node dist/eval/validate.js",
    "eval:dry-run": "node dist/eval/run.js --dry-run",
    "eval:run": "node dist/eval/run.js",
    "eval:score": "node dist/eval/score.js",
    "eval:report": "node dist/eval/report.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
